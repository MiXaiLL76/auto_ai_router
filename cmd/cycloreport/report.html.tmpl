<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>gocyclo report</title>
<style>
:root {
  --bg: #f7f8fa; --panel: #ffffff; --fg: #1d2330; --muted: #5d6677; --line: #dfe3ea;
  --accent: #3563c9; --warn: #b7791f; --bad: #c2412d; --chip: #eef1f6;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #12151b; --panel: #1a1e26; --fg: #e4e8ef; --muted: #98a1b2; --line: #2c3240;
    --accent: #7b9ff0; --warn: #e0a84a; --bad: #ef7a63; --chip: #242a35;
    color-scheme: dark;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--fg); font: 14px/1.5 var(--sans); }
main { max-width: 78rem; margin: 0 auto; padding: 24px 16px 48px; display: grid; gap: 16px; }
h1 { margin: 0; font-size: 22px; }
h2 { margin: 0 0 4px; font-size: 15px; }
.sub, .note { color: var(--muted); margin: 0; }
.note { font-size: 12px; }
code { font-family: var(--mono); font-size: 0.92em; }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 12px; }
.tile, .card { background: var(--panel); border: 1px solid var(--line); border-radius: 8px; min-width: 0; }
.tile { padding: 12px 16px; }
.tile .k { font-size: 12px; color: var(--muted); }
.tile .v { font-size: 28px; font-variant-numeric: tabular-nums; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: 12px; }
.card { padding: 16px; display: grid; gap: 8px; align-content: start; }
.bars { display: grid; gap: 6px; }
.bar-row { display: grid; grid-template-columns: minmax(0, 1fr) 3rem; gap: 2px 8px; align-items: center; font-size: 12px; }
.bar-row .label { grid-column: 1 / -1; color: var(--muted); font-family: var(--mono); overflow-wrap: anywhere; }
.bar-row .track { height: 10px; }
.bar-row .fill { height: 100%; border-radius: 4px; background: var(--accent); min-width: 3px; }
.bar-row .num { text-align: right; font-variant-numeric: tabular-nums; }
.fill.warn { background: var(--warn); }
.fill.bad { background: var(--bad); }
.tools { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.tools input { flex: 1 1 16rem; min-width: 0; font: inherit; padding: 6px 10px; border: 1px solid var(--line); border-radius: 6px; background: var(--bg); color: var(--fg); }
.tools .count { color: var(--muted); font-size: 12px; font-variant-numeric: tabular-nums; }
.scroll { max-height: 70vh; overflow: auto; border-top: 1px solid var(--line); }
table { width: 100%; border-collapse: collapse; font-size: 13px; font-variant-numeric: tabular-nums; }
th { position: sticky; top: 0; background: var(--panel); text-align: left; padding: 0; border-bottom: 1px solid var(--line); }
th button { all: unset; display: block; padding: 6px 8px; cursor: pointer; color: var(--muted); font-weight: 600; }
th button:focus-visible, a:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
th[aria-sort=ascending] button::after { content: " ▲"; }
th[aria-sort=descending] button::after { content: " ▼"; }
td { padding: 6px 8px; border-bottom: 1px solid var(--line); vertical-align: middle; }
.cx { display: flex; align-items: center; gap: 8px; min-width: 9rem; }
.cx span { width: 2.5rem; text-align: right; flex: none; }
.cx .track { flex: 1; height: 8px; }
.fn { font-family: var(--mono); overflow-wrap: anywhere; }
.loc { font-family: var(--mono); color: var(--muted); overflow-wrap: anywhere; }
a { color: var(--accent); }
.empty { padding: 32px; text-align: center; color: var(--muted); }
@media (max-width: 40rem) { .hide-narrow { display: none; } }
</style>
</head>
<body>
<main>
  <header>
    <h1>gocyclo report</h1>
    <p class="sub">Functions with cyclomatic complexity above {{if .Threshold}}{{.Threshold}}{{else}}the threshold{{end}}{{if .Commit}} · commit <code>{{.Commit}}</code>{{end}} · {{.Generated}}</p>
  </header>

  <section class="tiles" aria-label="Summary">
    <div class="tile"><div class="k">Functions above threshold</div><div class="v">{{.Total}}</div></div>
    <div class="tile"><div class="k">Above 50</div><div class="v">{{.Over50}}</div></div>
    <div class="tile"><div class="k">Highest complexity</div><div class="v">{{.Max}}</div></div>
    <div class="tile"><div class="k">Packages affected</div><div class="v">{{len .Packages}}</div></div>
  </section>

  {{if .Funcs}}
  <div class="grid">
    <section class="card">
      <h2>By complexity range</h2>
      <p class="note">The further right, the more a refactor costs.</p>
      <div class="bars">
        {{range $i, $b := .Buckets}}
        <div class="bar-row">
          <div class="label">{{$b.Label}}</div>
          <div class="track"><div class="fill{{if ge $i 3}} bad{{else if eq $i 2}} warn{{end}}" style="width: {{$b.BarPct}}%"></div></div>
          <div class="num">{{$b.Count}}</div>
        </div>
        {{end}}
      </div>
    </section>
    <section class="card">
      <h2>By package</h2>
      <p class="note">Functions above the threshold per directory; the highest value is in brackets.</p>
      <div class="bars">
        {{range .Packages}}
        <div class="bar-row">
          <div class="label">{{.Name}} (max {{.Max}})</div>
          <div class="track"><div class="fill" style="width: {{.BarPct}}%"></div></div>
          <div class="num">{{.Count}}</div>
        </div>
        {{end}}
      </div>
    </section>
  </div>

  <section class="card">
    <h2>All functions</h2>
    <div class="tools">
      <input id="q" type="search" placeholder="Filter by function, file or package" aria-label="Filter by function, file or package">
      <span class="count" id="count"></span>
    </div>
    <div class="scroll">
      <table id="funcs">
        <thead><tr>
          <th aria-sort="descending"><button data-key="complexity" data-num="1">Complexity</button></th>
          <th aria-sort="none"><button data-key="name">Function</button></th>
          <th aria-sort="none"><button data-key="loc">Location</button></th>
          <th aria-sort="none" class="hide-narrow"><button data-key="pkg">Package</button></th>
        </tr></thead>
        <tbody>
          {{range .Funcs}}
          <tr data-complexity="{{.Complexity}}" data-name="{{.Name}}" data-loc="{{.File}}:{{.Line}}" data-pkg="{{.Package}}">
            <td><div class="cx"><span>{{.Complexity}}</span><div class="track"><div class="fill{{if gt .Complexity 50}} bad{{else if gt .Complexity 30}} warn{{end}}" style="width: {{.BarPct}}%"></div></div></div></td>
            <td class="fn">{{.Name}}</td>
            <td class="loc">{{if .URL}}<a href="{{.URL}}" target="_blank" rel="noopener">{{.File}}:{{.Line}}</a>{{else}}{{.File}}:{{.Line}}{{end}}</td>
            <td class="loc hide-narrow">{{.Package}}</td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
  </section>
  {{else}}
  <section class="card empty">No functions above the threshold.</section>
  {{end}}
</main>
<script>
(function () {
  var table = document.getElementById('funcs');
  if (!table) return;
  var tbody = table.tBodies[0];
  var rows = Array.prototype.slice.call(tbody.rows);
  var q = document.getElementById('q');
  var count = document.getElementById('count');
  var sort = { key: 'complexity', num: true, dir: -1 };

  function render() {
    var needle = q.value.trim().toLowerCase();
    var shown = 0;
    rows.sort(function (a, b) {
      var va = a.dataset[sort.key], vb = b.dataset[sort.key];
      var c = sort.num ? va - vb : va.localeCompare(vb);
      return c * sort.dir || b.dataset.complexity - a.dataset.complexity;
    });
    rows.forEach(function (r) {
      var hit = !needle || (r.dataset.name + ' ' + r.dataset.loc).toLowerCase().indexOf(needle) !== -1;
      r.hidden = !hit;
      if (hit) shown++;
      tbody.appendChild(r);
    });
    count.textContent = 'Showing ' + shown + ' of ' + rows.length;
  }

  table.querySelectorAll('th button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.dataset.key;
      if (sort.key === key) sort.dir = -sort.dir;
      else sort = { key: key, num: !!btn.dataset.num, dir: btn.dataset.num ? -1 : 1 };
      table.querySelectorAll('th').forEach(function (th) {
        th.setAttribute('aria-sort', th.contains(btn) ? (sort.dir < 0 ? 'descending' : 'ascending') : 'none');
      });
      render();
    });
  });
  q.addEventListener('input', render);
  render();
})();
</script>
</body>
</html>
